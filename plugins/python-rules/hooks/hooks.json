{
  "description": "Inject python rules into system prompt on session start",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules ${CLAUDE_PLUGIN_ROOT}/rules/*.md",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
