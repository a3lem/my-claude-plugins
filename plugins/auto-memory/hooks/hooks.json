{
  "description": "Inject auto-memory rules and MEMORY.md into system prompt on session start",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inject-memory ${CLAUDE_PLUGIN_ROOT}/hooks/auto-memory.template.md",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
